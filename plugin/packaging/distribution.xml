<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>VHS @VERSION@</title>
    <options customize="always" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <allowed-os-versions><os-version min="10.13"/></allowed-os-versions>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
    </choices-outline>
    <choice id="vst3" title="VST3 plug-in" description="Installs VHS.vst3 in /Library/Audio/Plug-Ins/VST3.">
        <pkg-ref id="com.memorecks.vhs.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit plug-in" description="Installs VHS.component in /Library/Audio/Plug-Ins/Components (Logic Pro, GarageBand, ...).">
        <pkg-ref id="com.memorecks.vhs.au"/>
    </choice>
    <choice id="app" title="Standalone app" description="Installs VHS.app in /Applications." start_selected="false">
        <pkg-ref id="com.memorecks.vhs.app"/>
    </choice>
    <pkg-ref id="com.memorecks.vhs.vst3" version="@VERSION@">vst3.pkg</pkg-ref>
    <pkg-ref id="com.memorecks.vhs.au" version="@VERSION@">au.pkg</pkg-ref>
    <pkg-ref id="com.memorecks.vhs.app" version="@VERSION@">app.pkg</pkg-ref>
</installer-gui-script>
